{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "A runnable showcase of agentic workflows: day planning, multi-agent orchestration, and a five-minute war-room demo in the terminal and the browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/cli.ts war-room",
    "demo:plan": "tsx src/cli.ts plan",
    "demo:brief": "tsx src/cli.ts brief",
    "demo:trace": "tsx src/cli.ts trace",
    "demo:all": "tsx src/cli.ts all",
    "demo:live": "tsx src/cli.ts war-room --live",
    "build:web": "esbuild web/main.ts --bundle --minify --format=esm --target=es2022 --outfile=docs/app.js",
    "preview": "npm run build:web && node scripts/preview.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
