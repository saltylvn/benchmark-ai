# Benchmark runs in mock mode unless you opt in.
# Schedule decisions never go through a model. A live provider can only polish prose.

# Set to openai and pass --live (npm run demo:live) to polish the brief and drafts.
BENCHMARK_PROVIDER=mock

# Used only with --live and BENCHMARK_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# --- Python dashboard (python -m dashboard) -------------------------------
# Connect Slack with a bot token (scopes: chat:write) and a channel id the bot is in...
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# ...or with an incoming webhook.
SLACK_WEBHOOK_URL=
# Nothing posts unless this is exactly 1 AND a PM presses "Approve & send".
SLACK_SEND_ENABLED=0

# --- Dashboard sign-in (optional; "View the demo" always works) -------------
# Session cookie key. Set it so sign-ins survive a restart.
DASHBOARD_SECRET=
# Callback base when the dashboard runs behind a proxy or on a public URL.
PUBLIC_URL=
# Only these email domains may sign in (comma separated). Empty = any.
ALLOWED_EMAIL_DOMAINS=
# ...or exact addresses (comma separated), for a team on personal Gmail accounts.
ALLOWED_EMAILS=
# Redirect URI for each provider: <PUBLIC_URL or http://127.0.0.1:5050>/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Serve on your Wi-Fi so an iPhone or iPad can open it.
DASHBOARD_HOST=127.0.0.1

# Post the team morning brief to SLACK_CHANNEL once a day at this local time (needs SLACK_SEND_ENABLED=1).
BRIEF_AT=
