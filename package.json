{
  "name": "benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "A team of AI agents for construction project managers. The demo runs in mock mode and sends nothing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/cli.ts thursday",
    "demo:plan": "tsx src/cli.ts plan",
    "demo:brief": "tsx src/cli.ts brief",
    "demo:trace": "tsx src/cli.ts trace",
    "demo:all": "tsx src/cli.ts all",
    "demo:live": "tsx src/cli.ts thursday --live",
    "build:web": "esbuild web/main.ts --bundle --minify --format=esm --target=es2022 --outfile=docs/app.js",
    "preview": "npm run build:web && node scripts/preview.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "export:dashboard": "tsx src/export/snapshot.ts dashboard/data/snapshot.json",
    "dashboard": "npm run export:dashboard && python3 -m dashboard",
    "test:dashboard": "python3 -m unittest discover -s dashboard/tests -t ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
