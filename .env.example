# Atlas runs in mock mode unless you opt in.
# Schedule decisions never go through a model. A live provider can only polish prose.

# Set to openai and pass --live (npm run demo:live) to polish the brief and drafts.
ATLAS_PROVIDER=mock

# Used only with --live and ATLAS_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
